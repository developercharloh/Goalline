{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/probet-tips run build",
  "outputDirectory": "artifacts/probet-tips/dist/public",
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin(?:/.*)?",
      "has": [
        {
          "type": "host",
          "value": "^probet-tips\\.vercel\\.app$"
        }
      ],
      "status": 308,
      "dest": "https://admin-probet-tips.vercel.app/"
    },
    {
      "src": "/admin(?:/.*)?",
      "has": [
        {
          "type": "host",
          "value": "^admin-probet-tips\\.vercel\\.app$"
        }
      ],
      "status": 308,
      "dest": "https://admin-probet-tips.vercel.app/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
