{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/probet-tips run build",
  "outputDirectory": "artifacts/probet-tips/dist/public",
  "routes": [
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin(?:/.*)?",
      "has": [
        {
          "type": "host",
          "value": "^probet-tips\\.vercel\\.app$"
        }
      ],
      "status": 308,
      "dest": "https://admin-probet-tips.vercel.app/"
    },
    {
      "src": "/admin(?:/.*)?",
      "has": [
        {
          "type": "host",
          "value": "^probet-tips\\.site$"
        }
      ],
      "status": 308,
      "dest": "https://admin-probet-tips.vercel.app/"
    },
    {
      "src": "/admin(?:/.*)?",
      "has": [
        {
          "type": "host",
          "value": "^admin-probet-tips\\.vercel\\.app$"
        }
      ],
      "status": 308,
      "dest": "https://admin-probet-tips.vercel.app/"
    },
    {
      "src": "/downloads/probet-tips\\.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"probet-tips.apk\"",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
